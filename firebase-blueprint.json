{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered faculty member or coordinator with Google email access control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["coordinator", "teacher"] },
        "specialty": { "type": "string" },
        "grades": { "type": "array", "items": { "type": "string" } },
        "sections": { "type": "array", "items": { "type": "string" } },
        "avatar": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "fullName", "role"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Curricular subjects configurable by coordinators for planning and schedules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "applicableGrades": { "type": "array", "items": { "type": "string" } },
        "isCustom": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "category"]
    },
    "ClassSchedule": {
      "title": "ClassSchedule",
      "description": "Weekly timetable grid per grade and school year",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "grade": { "type": "string" },
        "lapso": { "type": "string" },
        "weekNumber": { "type": "integer" },
        "schoolYear": { "type": "string" },
        "isSaved": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["grade", "lapso", "weekNumber", "schoolYear"]
    }
  },
  "firestore": {
    "users": { "schema": "User", "description": "Authorized teachers and coordinators" },
    "subjects": { "schema": "Subject", "description": "Institutional subjects catalog" },
    "class_schedules": { "schema": "ClassSchedule", "description": "Weekly timetable allocations" }
  }
}
