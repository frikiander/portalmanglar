# ── Gemini AI ──────────────────────────────────────────────────────────────
# Required for Gemini AI API calls. Injected automatically by AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── Supabase (Backend principal) ──────────────────────────────────────
# Obtener en: https://supabase.com → tu proyecto → Settings → API
# Estas son públicas (anon key) — son seguras para incluir en el frontend.
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-clave-anonima-publica"

# ── App URL ───────────────────────────────────────────────────────────────
# URL de la app. Usado para OAuth redirects y links internos.
APP_URL="MY_APP_URL"
